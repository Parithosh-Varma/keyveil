{
  "name": "keyveil-landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build && node ../../scripts/prerender.mjs dist",
