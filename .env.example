# Copy to .env (local only, never commit). Production values go in
# Cloudflare dashboard / `wrangler secret put`, not in git.

# --- Google OAuth (Cloudflare Worker handles code exchange) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://api.yourdomain.com/v1/auth/google/callback
WEB_BASE_URL=https://yourdomain.com
SESSION_SECRET=

# --- Agent bootstrap (local dev only) ---
VEIL_AGENT_TOKEN=
API_BASE_URL=http://127.0.0.1:8787

# --- Wrangler bindings (set IDs in workers/api/wrangler.toml) ---
D1_DATABASE_ID=
KV_NAMESPACE_ID=
